# Copy to .env in the workspace root and fill in (kept out of git).
# Used by: .agents/skills/email-send/scripts/local_email_send.py

# SMTP
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Display name and from-address (envelope: FROM_EMAIL if set, else SMTP_USERNAME)
FROM_ADDRESS=My Name
FROM_EMAIL=
# Optional, comma-separated
COPY_ADDRESSES=
BCC_ADDRESSES=cosverifier@gmail.com

# Max emails per minute (0 = unlimited). Match your SMTP provider rate limit.
SMTP_RATE_LIMIT_PER_MIN=0

# Validation limits (security and DoS protection)
MAX_ATTACHMENT_SIZE_MB=1
MAX_JSON_SIZE_MB=10
MAX_HTML_SIZE_MB=5
MAX_RECIPIENTS=10000
MAX_SUBJECT_LENGTH=500
MAX_ATTACHMENTS=10
